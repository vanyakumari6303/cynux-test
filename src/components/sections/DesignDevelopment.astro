---
/** A5 · Design & Development. Content: src/data/design-dev.js */
import '../../styles/sections/design-development.css';
import { designDevPanels } from '../../data/design-dev.js';
---
<section class="dd" id="design-development" aria-labelledby="dd-title">
  <header class="dd__head">
    <div class="dd__headl">
      <p class="dd__eyebrow">03 — DESIGN &amp; DEVELOPMENT</p>
      <h2 class="dd__title" id="dd-title">Design and development,<br><span>secured by default.</span></h2>
    </div>
    <p class="dd__lede">Need a website, an app or a full product? Our designers and developers build it, and our security team tests it before launch.</p>
  </header>
  <div class="dd__panels">
    {designDevPanels.map((p) => (
      <article class={`dd__panel dd__panel--${p.variant}`} id={p.id} aria-labelledby={`${p.id}-title`}>
        <div class="dd__ph">
          <img class="dd__glow" src={p.glow} width="288" height="240" alt="">
          <img class="dd__iso" src={p.iso} width="298" height="240" alt="">
          <div class="dd__phtext">
            <h3 class="dd__pt" id={`${p.id}-title`}>{p.title}</h3>
            <p class="dd__ps">{p.subtitle}</p>
          </div>
        </div>
        <ul class="dd__list">
          {p.items.map((it) => (
            <li><a class="dd__item" href="#book">
              <span class="dd__ic"><img src={`/assets/${it.icon}.svg`} width="20" height="20" alt=""></span>
              <span class="dd__txt"><span class="dd__it">{it.title}</span><span class="dd__id">{it.desc}</span></span>
              <img class="dd__go" src="/assets/arrow-ur.svg" width="18" height="18" alt="">
            </a></li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
