---
/** E1 · Hero */
import '../../styles/sections/hero.css';
import Nav from '../Nav.astro';
---
<header class="hero">
  <img class="glow glow--top" src="/assets/glow-top.svg" width="1400" height="640" alt="">
  <img class="glow glow--bottom" src="/assets/glow-bottom.svg" width="900" height="313" alt="">

  <Nav />

  <div class="content">
    <span class="eyebrow"><img src="/assets/dot.svg" width="6" height="6" alt=""># Our services</span>

    <h1 class="headline">
      <span class="headline__row">
        <span>We</span>
        <span class="c-violet">secure,</span>
        <span class="pill pill--shield" aria-hidden="true"><img src="/assets/shield.svg" width="36" height="36" alt=""></span>
      </span>
      <span class="headline__row headline__row--mid">
        <span class="c-pink">design</span>
        <span class="pill pill--pen" aria-hidden="true"><img src="/assets/pen.svg" width="32" height="32" alt=""></span>
        <span>and</span>
        <span class="c-green">build</span>
      </span>
      <span class="headline__row">
        <span>digital products.</span>
        <span class="pill pill--code" aria-hidden="true">
          <span class="bar b1"></span><span class="bar b2"></span><span class="bar b3"></span>
          <img src="/assets/code.svg" width="24" height="24" alt="">
        </span>
      </span>
    </h1>

    <p class="lede">Cybersecurity, design and development under one roof. One project lead stays with you from the first call to launch day, and after.</p>

    <div class="ctas">
      <a class="btn-primary" href="#book">Book a free consultation <img src="/assets/arrow-right.svg" width="18" height="18" alt=""></a>
      <a class="btn-ghost" href="#what-we-do">See all services</a>
    </div>

    <p class="note">Free 30-minute call  ·  speak to the person who will lead your project</p>
  </div>
</header>
